# Copy this file to .env.local for local development (never commit .env.local).
# Every value below is a placeholder — no real keys or secrets belong in this file.
# See DECISIONS.md for which increment introduces each variable.

# --- Site ------------------------------------------------------------------
# Canonical site URL. Used for absolute URLs (sitemap, OG tags, canonical links,
# Lemon Squeezy/Supabase redirect targets). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (introduced increment 2 — catalog schema, increment 4 — auth) -
# Project URL and anon (public) key: safe to expose to the browser, RLS enforces access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-only, NEVER prefixed with NEXT_PUBLIC_, never sent to the client.
# Used only in server-side code (webhook handler, signed-URL issuance, admin grants).
SUPABASE_SERVICE_ROLE_KEY=

# --- Lemon Squeezy (introduced increment 5 — payments schema + integration) -
# Server-only API key for creating checkout sessions. Never exposed to the client.
LEMONSQUEEZY_API_KEY=
# The store this project sells through.
LEMONSQUEEZY_STORE_ID=
# Secret used to verify the HMAC signature on incoming webhook requests.
# Requests failing signature verification must be rejected before any payload parsing.
LEMONSQUEEZY_WEBHOOK_SECRET=

# --- Rate limiting (introduced increment 8 — hardening pass) ---------------
# Backend choice (Upstash Redis vs. Postgres-backed) confirmed with the Approver
# at increment 8; variables added here once decided.

# --- Video host (introduced increment 6 — protected library delivery) ------
# Provider (Vimeo / Loom / unlisted YouTube) confirmed with the Approver at
# increment 6; any required API key/domain added here once decided.
